public class Truck extends Vehicle {
    private double payloadTons;

    public Truck(String id, String brand, int year, double payloadTons) {
        super(id, brand, year);
        this.payloadTons = payloadTons;
    }
    @Override
    public void displayInfo(){
        super.displayInfo();
        System.out.println("Tải trọng: " +payloadTons+ "tấn");
    }
}
